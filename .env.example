# ============================================================
# MediAgent Environment Configuration
# Copy this file to .env and fill in your values
# cp .env.example .env
# ============================================================

# ---- LLM Configuration ----
DEEPSEEK_API_KEY=sk-your-api-key-here
DEEPSEEK_API_BASE=https://api.deepseek.com/v1

# ---- Security Configuration ----
# Comma-separated API keys for authentication (optional, leave empty to disable)
AUTH_API_KEYS=
# Rate limiting: max requests per minute per client
RATE_LIMIT_PER_MINUTE=30
# Rate limiting: burst capacity
RATE_LIMIT_BURST=10
# Allowed CORS origins (comma-separated, use * for all)
ALLOWED_ORIGINS=*
# CORS origins for FastAPI middleware (comma-separated)
CORS_ORIGINS=*

# ---- Application Configuration ----
# Agent display name
AGENT_NAME=MediAgent 智慧医疗助手
# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
